{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "java_orchard",
      "camelcase": "JavaOrchard",
      "title": "Java",
      "scope": "source.java",
      "file-types": [
        "java"
      ],
      "injection-regex": "^java$",
      "class-name": "TreeSitterJavaOrchard"
    }
  ],
  "metadata": {
    "version": "0.5.23",
    "license": "MIT",
    "description": "Java grammar for tree-sitter",
    "authors": [
      {
        "name": "Ayman Nadeem",
        "email": "aymannadeem@github.com"
      },
      {
        "name": "Max Brunsfeld",
        "email": "maxbrunsfeld@gmail.com"
      },
      {
        "name": "Amaan Qureshi",
        "email": "amaanq12@gmail.com"
      }
    ],
    "links": {
      "repository": "https://codeberg.org/grammar-orchard/tree-sitter-java-orchard",
      "upstream": "https://github.com/tree-sitter/tree-sitter-java",
      "github_mirror": "https://github.com/grammar-orchard/tree-sitter-java-orchard"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
